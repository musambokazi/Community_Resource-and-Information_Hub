# Community Hub — Required Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Requires Places API enabled. Restrict the key to your server's IP in prod.
GOOGLE_MAPS_API_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/community_hub
DB_NAME=community_hub
DB_USER=community_hub_user
DB_PASSWORD=

# ── Redis (Rate Limiter) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SEO / Sitemap ─────────────────────────────────────────────────────────────
BASE_URL=https://yourdomain.com
